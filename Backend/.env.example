# Map API (frontend)
# Server-side Google Maps key (Distance Matrix + Directions APIs must be enabled)
GOOGLE_MAPS_SERVER_KEY=
# Optional alias used by backend when server key is not set
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Firebase (frontend & backend)
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Razorpay Payment Gateway
#
# RAZORPAY_ENVIRONMENT selects WHICH pair below is used. The key prefix must match the
# environment (rzp_test_… for test, rzp_live_… for live) — a mismatch fails closed and
# disables payments rather than transacting with the wrong key.
RAZORPAY_ENVIRONMENT=test

# Used when RAZORPAY_ENVIRONMENT=test. Falls back to RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET
# below, so an existing single-key setup keeps working.
RAZORPAY_TEST_API_KEY=
RAZORPAY_TEST_SECRET_KEY=

# Used when RAZORPAY_ENVIRONMENT=live. No fallback — live must be set explicitly.
RAZORPAY_LIVE_API_KEY=
RAZORPAY_LIVE_SECRET_KEY=

# Legacy single-key vars. Still honoured as the TEST fallback.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# REQUIRED for payment webhooks. The handler fails closed: while this is empty every webhook
# is rejected with 400, so payment.captured / refund events are never processed.
# Value must match the secret configured on the Razorpay dashboard webhook.
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp (BhashSMS) - login OTP + order status messages (created/delivered/cancelled/refunded)
WHATSAPP_API_BASE_URL=http://bhashsms.com/api/sendmsg.php
WHATSAPP_API_USERNAME=
WHATSAPP_API_PASSWORD=
WHATSAPP_SENDER_NUMBER=
WHATSAPP_OTP_TEMPLATE=otp_login
WHATSAPP_ORDER_TEMPLATE=order_status
# true  = no WhatsApp OTP is sent, every login OTP is 1234 (testing)
# false = real OTP sent on WhatsApp
USE_DEFAULT_OTP=false

# Mail Settings
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@appzeto.com
MAIL_FROM_NAME=Appzeto

# --- Backend performance (Food-first; optional for local dev) ---
# MongoDB connection pool
MONGO_MAX_POOL_SIZE=10
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000

# Redis (enables API response cache + BullMQ). Works without Redis via in-memory fallback.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# BullMQ background workers (requires REDIS_ENABLED=true)
BULLMQ_ENABLED=false

# Realtime sync — see REALTIME_SYNC_PLAN.md.
# Writes a per-recipient event log so a client that was offline can recover what it missed.
# OFF = publish() behaves exactly like the old direct socket emit (no extra writes).
SYNC_CURSOR_ENABLED=false
# Days to keep the recovery buffer. 0 disables expiry; setting it deletes rows older than
# the window on the next index build.
SYNC_EVENT_TTL_DAYS=0

# In-process cache cap when Redis is disabled
MEMORY_CACHE_MAX_ENTRIES=500

# Food image upload compression (Sharp)
FOOD_IMAGE_QUALITY=82
FOOD_IMAGE_MAX_DIMENSION=2048
